<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Gray">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="{StaticResource Primary}"
               FontFamily="MouseMemoirs-Regular"
               FontSize="50"
               HorizontalTextAlignment="Center"/>


        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *">
                <!-- Coluna 0: Adultos -->
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Adultos: " />
                    <Label Text="{Binding QntdAdultos}" 
                   TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>

                <!-- Coluna 1: Crianças -->
                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Crianças: " />
                    <Label Text="{Binding QntdCriancas}" 
                   TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>


        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: "/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: "/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: "/>
                
                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding DataCheckIn, StringFormat = '{}{0: dd/MM/yyyy}'} "
                        TextColor ="{StaticResource Magenta}" />
                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding DataCheckOut, StringFormat = '{}{0: dd/MM/yyyy}'} "
                        TextColor ="{StaticResource Magenta}" />
                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Estadia} "
                        TextColor ="{StaticResource Magenta}" />
            </Grid>

        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor total: "/>
                <Label Text="{Binding ValorTotal , StringFormat = '{}{0:c}'} "
                    TextColor ="{StaticResource Magenta}"    />
                 
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"/>










    </VerticalStackLayout>
    
</ContentPage>